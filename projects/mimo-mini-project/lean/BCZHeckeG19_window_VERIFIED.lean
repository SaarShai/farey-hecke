import Mathlib
set_option maxHeartbeats 400000000
set_option maxRecDepth 10000
noncomputable section
open Int

/-- Interior-floor contradiction (K>=2 impossible inside a sub-threshold window): if a
middle coord `m` has `lam^4 m^2 < 1` (= the K>=2 bound) and a neighbour `n` with `lam^4 n^2
< 2` and edge `1 - lam m < n`, then False.  Uses only `9/5 < lam < 2` via `(lam^2-lam)^2
>= 2` — field-independent. -/
lemma g19_floor_helper (lam m n : ℝ) (h2 : (1:ℝ) < lam) (h3 : lam < 2)
    (hlo : (9:ℝ)/5 < lam) (hm : 0 < m) (hn : 0 < n)
    (hms : lam^4 * m^2 < 1) (hns : lam^4 * n^2 < 2) (hedge : 1 - lam*m < n) : False := by
  have hpos : (0:ℝ) < lam := by linarith
  have hl2 : (1:ℝ) < lam^2 := by nlinarith [h2]
  have hlm : lam^2 * m < 1 := by nlinarith [hms, mul_pos (mul_pos hpos hpos) hm, sq_nonneg (lam^2*m)]
  have hlm1 : lam*m < 1 := by nlinarith [hlm, hl2, hm, mul_pos hpos hm]
  have h1lm : (0:ℝ) < 1 - lam*m := by linarith
  have hnsq : (1 - lam*m)^2 < n^2 := by nlinarith [hedge, h1lm, hn]
  have hml : (36:ℝ)/25 ≤ lam^2 - lam := by nlinarith [mul_pos (show (0:ℝ)<lam-9/5 by linarith) (show (0:ℝ)<lam+4/5 by linarith)]
  have hKey : (2:ℝ) ≤ lam^4 - 2*lam^3 + lam^2 := by nlinarith [hml, sq_nonneg (lam^2-lam), mul_pos hpos (show (0:ℝ)<lam-1 by linarith)]
  have hA : lam^4 * (1 - lam*m)^2 < 2 := by nlinarith [hnsq, hns, mul_pos (mul_pos (mul_pos hpos hpos) hpos) hpos]
  nlinarith [hA, hKey, h1lm, hlm, hpos, hl2, mul_pos hpos h1lm, sq_nonneg (lam - lam^2*m), sq_nonneg (lam*(1-lam*m))]

lemma case_q19 (a b c d e f g lam : ℝ) (hps : lam^9 = lam^8 + 8*lam^7 - 7*lam^6 - 21*lam^5 + 15*lam^4 + 20*lam^3 - 10*lam^2 - 5*lam + 1) (h2 : (1:ℝ) < lam) (h3 : lam < 2)
    (hpa : 0 < a) (hpb : 0 < b) (hpc : 0 < c) (hpd : 0 < d) (hpe : 0 < e) (hpf : 0 < f) (hpg : 0 < g)
    (hca : a ≤ 1) (hcb : b ≤ 1) (hcc : c ≤ 1) (hcd : d ≤ 1) (hce : e ≤ 1) (hcf : f ≤ 1) (hcg : g ≤ 1)
    (hr0 : a+lam*b > 1) (hr1 : b+lam*c > 1) (hr2 : c+lam*d > 1) (hr3 : d+lam*e > 1) (hr4 : e+lam*f > 1) (hr5 : f+lam*g > 1)
    (hg0 : lam*a+b > 1) (hg1 : lam*b+c > 1) (hg2 : lam*c+d > 1) (hg3 : lam*d+e > 1) (hg4 : lam*e+f > 1) (hg5 : lam*f+g > 1)
    (hk0 : a+c = 1*lam*b) (hk1 : b+d = 1*lam*c) (hk2 : c+e = 1*lam*d) (hk3 : d+f = 1*lam*e) (hk4 : e+g = 1*lam*f)
    (hf0 : 1+a < (1+1)*(lam*b)) (hf1 : 1+b < (1+1)*(lam*c)) (hf2 : 1+c < (1+1)*(lam*d)) (hf3 : 1+d < (1+1)*(lam*e)) (hf4 : 1+e < (1+1)*(lam*f))
    (hP0 : a*b < 1/lam^3) (hP1 : b*c < 1/lam^3) (hP2 : c*d < 1/lam^3) (hP3 : d*e < 1/lam^3) (hP4 : e*f < 1/lam^3) (hP5 : f*g < 1/lam^3) :
    False := by
  have hpos : (0:ℝ) < lam := by linarith
  have hp3 : (0:ℝ) < lam^3 := by positivity
  have pos0 : (0:ℝ) ≤ a := le_of_lt hpa
  have pos1 : (0:ℝ) ≤ b := le_of_lt hpb
  have pos2 : (0:ℝ) ≤ c := le_of_lt hpc
  have pos3 : (0:ℝ) ≤ d := le_of_lt hpd
  have pos4 : (0:ℝ) ≤ e := le_of_lt hpe
  have pos5 : (0:ℝ) ≤ f := le_of_lt hpf
  have pos6 : (0:ℝ) ≤ g := le_of_lt hpg
  have cap0 : (0:ℝ) ≤ 1 - a := by nlinarith [hca]
  have cap1 : (0:ℝ) ≤ 1 - b := by nlinarith [hcb]
  have cap2 : (0:ℝ) ≤ 1 - c := by nlinarith [hcc]
  have cap3 : (0:ℝ) ≤ 1 - d := by nlinarith [hcd]
  have cap4 : (0:ℝ) ≤ 1 - e := by nlinarith [hce]
  have cap5 : (0:ℝ) ≤ 1 - f := by nlinarith [hcf]
  have cap6 : (0:ℝ) ≤ 1 - g := by nlinarith [hcg]
  have reg0 : (0:ℝ) ≤ a + b*lam - 1 := by nlinarith [hr0]
  have reg1 : (0:ℝ) ≤ b + c*lam - 1 := by nlinarith [hr1]
  have reg2 : (0:ℝ) ≤ c + d*lam - 1 := by nlinarith [hr2]
  have reg3 : (0:ℝ) ≤ d + e*lam - 1 := by nlinarith [hr3]
  have reg4 : (0:ℝ) ≤ e + f*lam - 1 := by nlinarith [hr4]
  have reg5 : (0:ℝ) ≤ f + g*lam - 1 := by nlinarith [hr5]
  have gen0 : (0:ℝ) ≤ a*lam + b - 1 := by nlinarith [hg0]
  have gen1 : (0:ℝ) ≤ b*lam + c - 1 := by nlinarith [hg1]
  have gen2 : (0:ℝ) ≤ c*lam + d - 1 := by nlinarith [hg2]
  have gen3 : (0:ℝ) ≤ d*lam + e - 1 := by nlinarith [hg3]
  have gen4 : (0:ℝ) ≤ e*lam + f - 1 := by nlinarith [hg4]
  have gen5 : (0:ℝ) ≤ f*lam + g - 1 := by nlinarith [hg5]
  have slk0 : (0:ℝ) ≤ -a*b*lam^3 + 1 := by
    have hh : (a*b)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP0
    nlinarith [hh]
  have slk1 : (0:ℝ) ≤ -b*c*lam^3 + 1 := by
    have hh : (b*c)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP1
    nlinarith [hh]
  have slk2 : (0:ℝ) ≤ -c*d*lam^3 + 1 := by
    have hh : (c*d)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP2
    nlinarith [hh]
  have slk3 : (0:ℝ) ≤ -d*e*lam^3 + 1 := by
    have hh : (d*e)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP3
    nlinarith [hh]
  have slk4 : (0:ℝ) ≤ -e*f*lam^3 + 1 := by
    have hh : (e*f)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP4
    nlinarith [hh]
  have slk5 : (0:ℝ) ≤ -f*g*lam^3 + 1 := by
    have hh : (f*g)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP5
    nlinarith [hh]
  have flu0 : (0:ℝ) ≤ -a + 2*b*lam - 1 := by nlinarith [hf0]
  have flu1 : (0:ℝ) ≤ -b + 2*c*lam - 1 := by nlinarith [hf1]
  have flu2 : (0:ℝ) ≤ -c + 2*d*lam - 1 := by nlinarith [hf2]
  have flu3 : (0:ℝ) ≤ -d + 2*e*lam - 1 := by nlinarith [hf3]
  have flu4 : (0:ℝ) ≤ -e + 2*f*lam - 1 := by nlinarith [hf4]
  -- Variable elimination: express c,d,e,f,g in terms of a,b,lam
  have hc_eq : c = lam * b - a := by linarith [hk0]
  have hd_eq : d = lam^2*b - lam*a - b := by have := hk1; rw [show c = lam*b-a from by linarith [hk0]] at this; linarith
  have he_eq : e = lam^3*b - lam^2*a - 2*lam*b + a := by
    have hc' := hc_eq; have hd' := hd_eq
    have := hk2; rw [hc', hd'] at this; linarith
  have hf_eq : f = lam^4*b - lam^3*a - 3*lam^2*b + 2*lam*a + b := by
    have hd' := hd_eq; have he' := he_eq
    have := hk3; rw [hd', he'] at this; linarith
  have hg_eq : g = lam^5*b - lam^4*a - 4*lam^3*b + 3*lam^2*a + 3*lam*b - a := by
    have he' := he_eq; have hf' := hf_eq
    have := hk4; rw [he', hf'] at this; linarith
  have qq0 : (0:ℝ) ≤ a^2*lam^2 + a*b*lam - a*lam := by
    have hr : (0:ℝ) ≤ lam*((a)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg pos0 gen0)
    have he : lam*((a)*(a*lam + b - 1)) = a^2*lam^2 + a*b*lam - a*lam := by ring
    linarith [hr, he]
  have qq1 : (0:ℝ) ≤ 4*a^2*lam^8 + a^2*lam^7 - 22*a^2*lam^6 - 6*a^2*lam^5 + 36*a^2*lam^4 + 10*a^2*lam^3 - 16*a^2*lam^2 - 4*a^2*lam + a^2 - 8*a*b*lam^8 - 12*a*b*lam^7 + 54*a*b*lam^6 + 60*a*b*lam^5 - 110*a*b*lam^4 - 84*a*b*lam^3 + 68*a*b*lam^2 + 27*a*b*lam - 6*a*b + a*lam^5 - 3*a*lam^3 + a*lam + 6*b^2*lam^8 + 4*b^2*lam^7 - 36*b^2*lam^6 - 23*b^2*lam^5 + 66*b^2*lam^4 + 36*b^2*lam^3 - 36*b^2*lam^2 - 13*b^2*lam + 3*b^2 - b*lam^6 + 4*b*lam^4 - 3*b*lam^2 := by
    have hr : (0:ℝ) ≤ lam*((g)*(f + g*lam - 1)) := mul_nonneg hpos.le (mul_nonneg pos6 reg5)
    have he : lam*((g)*(f + g*lam - 1)) = 4*a^2*lam^8 + a^2*lam^7 - 22*a^2*lam^6 - 6*a^2*lam^5 + 36*a^2*lam^4 + 10*a^2*lam^3 - 16*a^2*lam^2 - 4*a^2*lam + a^2 - 8*a*b*lam^8 - 12*a*b*lam^7 + 54*a*b*lam^6 + 60*a*b*lam^5 - 110*a*b*lam^4 - 84*a*b*lam^3 + 68*a*b*lam^2 + 27*a*b*lam - 6*a*b + a*lam^5 - 3*a*lam^3 + a*lam + 6*b^2*lam^8 + 4*b^2*lam^7 - 36*b^2*lam^6 - 23*b^2*lam^5 + 66*b^2*lam^4 + 36*b^2*lam^3 - 36*b^2*lam^2 - 13*b^2*lam + 3*b^2 - b*lam^6 + 4*b*lam^4 - 3*b*lam^2 := by rw [hf_eq, hg_eq]; linear_combination (a^2*lam + a^2 - 2*a*b*lam^2 - 2*a*b*lam - 6*a*b + b^2*lam^3 + b^2*lam^2 + 2*b^2*lam + 3*b^2)*hps
    linarith [hr, he]
  have qq2 : (0:ℝ) ≤ -a^2*lam^6 + 3*a^2*lam^4 - a^2*lam^2 + a*b*lam^7 - 5*a*b*lam^5 + 6*a*b*lam^3 - a*b*lam + a*lam^5 - 3*a*lam^3 + a*lam + b^2*lam^6 - 4*b^2*lam^4 + 3*b^2*lam^2 - b*lam^6 + 4*b*lam^4 - 3*b*lam^2 := by
    have hr : (0:ℝ) ≤ lam*((g)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg pos6 gen0)
    have he : lam*((g)*(a*lam + b - 1)) = -a^2*lam^6 + 3*a^2*lam^4 - a^2*lam^2 + a*b*lam^7 - 5*a*b*lam^5 + 6*a*b*lam^3 - a*b*lam + a*lam^5 - 3*a*lam^3 + a*lam + b^2*lam^6 - 4*b^2*lam^4 + 3*b^2*lam^2 - b*lam^6 + 4*b*lam^4 - 3*b*lam^2 := by rw [hg_eq]; ring
    linarith [hr, he]
  have qq3 : (0:ℝ) ≤ a*b*lam^6 - 2*a*b*lam^4 - a*b*lam^2 - a*lam^6 + 2*a*lam^4 + a*lam^2 - b^2*lam^7 + 3*b^2*lam^5 - b^2*lam + b*lam^7 - 3*b*lam^5 + 2*b*lam - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - b)*(f + g*lam - 1)) := mul_nonneg hpos.le (mul_nonneg cap1 reg5)
    have he : lam*((1 - b)*(f + g*lam - 1)) = a*b*lam^6 - 2*a*b*lam^4 - a*b*lam^2 - a*lam^6 + 2*a*lam^4 + a*lam^2 - b^2*lam^7 + 3*b^2*lam^5 - b^2*lam + b*lam^7 - 3*b*lam^5 + 2*b*lam - lam := by rw [hf_eq, hg_eq]; ring
    linarith [hr, he]
  have qq4 : (0:ℝ) ≤ a^2*b*lam^5 - a^2*lam^5 - 2*a*b^2*lam^6 + a*b^2*lam^4 + 2*a*b*lam^6 - a*b*lam^4 + b^3*lam^7 - b^3*lam^5 - b^2*lam^7 + b^2*lam^5 - b*lam + lam := by
    have hr : (0:ℝ) ≤ lam*((1 - b)*(-c*d*lam^3 + 1)) := mul_nonneg hpos.le (mul_nonneg cap1 slk2)
    have he : lam*((1 - b)*(-c*d*lam^3 + 1)) = a^2*b*lam^5 - a^2*lam^5 - 2*a*b^2*lam^6 + a*b^2*lam^4 + 2*a*b*lam^6 - a*b*lam^4 + b^3*lam^7 - b^3*lam^5 - b^2*lam^7 + b^2*lam^5 - b*lam + lam := by rw [hc_eq, hd_eq]; ring
    linarith [hr, he]
  have qq5 : (0:ℝ) ≤ -a^2*lam^8 + 3*a^2*lam^6 - a^2*lam^4 - a^2*lam^2 + 2*a*b*lam^8 + 8*a*b*lam^7 - 14*a*b*lam^6 - 36*a*b*lam^5 + 30*a*b*lam^4 + 43*a*b*lam^3 - 20*a*b*lam^2 - 11*a*b*lam + 2*a*b - a*lam^6 + 2*a*lam^4 - a*lam^3 + a*lam^2 + a*lam - 4*b^2*lam^8 - b^2*lam^7 + 22*b^2*lam^6 + 6*b^2*lam^5 - 36*b^2*lam^4 - 10*b^2*lam^3 + 17*b^2*lam^2 + 4*b^2*lam - b^2 + b*lam^7 - 3*b*lam^5 + b*lam^4 - 2*b*lam^2 + b*lam - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - e)*(f + g*lam - 1)) := mul_nonneg hpos.le (mul_nonneg cap4 reg5)
    have he : lam*((1 - e)*(f + g*lam - 1)) = -a^2*lam^8 + 3*a^2*lam^6 - a^2*lam^4 - a^2*lam^2 + 2*a*b*lam^8 + 8*a*b*lam^7 - 14*a*b*lam^6 - 36*a*b*lam^5 + 30*a*b*lam^4 + 43*a*b*lam^3 - 20*a*b*lam^2 - 11*a*b*lam + 2*a*b - a*lam^6 + 2*a*lam^4 - a*lam^3 + a*lam^2 + a*lam - 4*b^2*lam^8 - b^2*lam^7 + 22*b^2*lam^6 + 6*b^2*lam^5 - 36*b^2*lam^4 - 10*b^2*lam^3 + 17*b^2*lam^2 + 4*b^2*lam - b^2 + b*lam^7 - 3*b*lam^5 + b*lam^4 - 2*b*lam^2 + b*lam - lam := by rw [he_eq, hf_eq, hg_eq]; linear_combination (2*a*b - b^2*lam - b^2)*hps
    linarith [hr, he]
  have qq6 : (0:ℝ) ≤ -a^3*lam^7 + a^3*lam^5 + 3*a^2*b*lam^8 - 5*a^2*b*lam^6 + a^2*b*lam^4 - a^2*lam^5 - 3*a*b^2*lam^8 - 17*a*b^2*lam^7 + 21*a*b^2*lam^6 + 60*a*b^2*lam^5 - 45*a*b^2*lam^4 - 60*a*b^2*lam^3 + 30*a*b^2*lam^2 + 15*a*b^2*lam - 3*a*b^2 + 2*a*b*lam^6 - a*b*lam^4 + a*lam^3 - a*lam + 6*b^3*lam^8 + b^3*lam^7 - 26*b^3*lam^6 - 6*b^3*lam^5 + 35*b^3*lam^4 + 10*b^3*lam^3 - 15*b^3*lam^2 - 4*b^3*lam + b^3 - b^2*lam^7 + b^2*lam^5 - b*lam^4 + 2*b*lam^2 + lam := by
    have hr : (0:ℝ) ≤ lam*((1 - e)*(-c*d*lam^3 + 1)) := mul_nonneg hpos.le (mul_nonneg cap4 slk2)
    have he : lam*((1 - e)*(-c*d*lam^3 + 1)) = -a^3*lam^7 + a^3*lam^5 + 3*a^2*b*lam^8 - 5*a^2*b*lam^6 + a^2*b*lam^4 - a^2*lam^5 - 3*a*b^2*lam^8 - 17*a*b^2*lam^7 + 21*a*b^2*lam^6 + 60*a*b^2*lam^5 - 45*a*b^2*lam^4 - 60*a*b^2*lam^3 + 30*a*b^2*lam^2 + 15*a*b^2*lam - 3*a*b^2 + 2*a*b*lam^6 - a*b*lam^4 + a*lam^3 - a*lam + 6*b^3*lam^8 + b^3*lam^7 - 26*b^3*lam^6 - 6*b^3*lam^5 + 35*b^3*lam^4 + 10*b^3*lam^3 - 15*b^3*lam^2 - 4*b^3*lam + b^3 - b^2*lam^7 + b^2*lam^5 - b*lam^4 + 2*b*lam^2 + lam := by rw [hc_eq, hd_eq, he_eq]; linear_combination (-3*a*b^2 + b^3*lam + b^3)*hps
    linarith [hr, he]
  have qq7 : (0:ℝ) ≤ -a^2*lam^8 - 4*a^2*lam^7 + 7*a^2*lam^6 + 18*a^2*lam^5 - 15*a^2*lam^4 - 22*a^2*lam^3 + 10*a^2*lam^2 + 5*a^2*lam - a^2 + 8*a*b*lam^8 + 2*a*b*lam^7 - 44*a*b*lam^6 - 12*a*b*lam^5 + 72*a*b*lam^4 + 20*a*b*lam^3 - 33*a*b*lam^2 - 8*a*b*lam + 2*a*b - a*lam^6 + a*lam^4 + 3*a*lam^2 - 4*b^2*lam^8 - 6*b^2*lam^7 + 27*b^2*lam^6 + 30*b^2*lam^5 - 55*b^2*lam^4 - 42*b^2*lam^3 + 34*b^2*lam^2 + 13*b^2*lam - 3*b^2 + b*lam^7 - 2*b*lam^5 - 3*b*lam^3 + 2*b*lam - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - f)*(f + g*lam - 1)) := mul_nonneg hpos.le (mul_nonneg cap5 reg5)
    have he : lam*((1 - f)*(f + g*lam - 1)) = -a^2*lam^8 - 4*a^2*lam^7 + 7*a^2*lam^6 + 18*a^2*lam^5 - 15*a^2*lam^4 - 22*a^2*lam^3 + 10*a^2*lam^2 + 5*a^2*lam - a^2 + 8*a*b*lam^8 + 2*a*b*lam^7 - 44*a*b*lam^6 - 12*a*b*lam^5 + 72*a*b*lam^4 + 20*a*b*lam^3 - 33*a*b*lam^2 - 8*a*b*lam + 2*a*b - a*lam^6 + a*lam^4 + 3*a*lam^2 - 4*b^2*lam^8 - 6*b^2*lam^7 + 27*b^2*lam^6 + 30*b^2*lam^5 - 55*b^2*lam^4 - 42*b^2*lam^3 + 34*b^2*lam^2 + 13*b^2*lam - 3*b^2 + b*lam^7 - 2*b*lam^5 - 3*b*lam^3 + 2*b*lam - lam := by rw [hf_eq, hg_eq]; linear_combination (-a^2 + 2*a*b*lam + 2*a*b - b^2*lam^2 - b^2*lam - 3*b^2)*hps
    linarith [hr, he]
  have qq8 : (0:ℝ) ≤ a^2*lam^5 - 2*a^2*lam^3 - a*b*lam^6 + 4*a*b*lam^4 - 3*a*b*lam^2 - a*lam^4 + 3*a*lam^2 - b^2*lam^5 + 3*b^2*lam^3 - b^2*lam + b*lam^5 - 3*b*lam^3 + 2*b*lam - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - f)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg cap5 gen0)
    have he : lam*((1 - f)*(a*lam + b - 1)) = a^2*lam^5 - 2*a^2*lam^3 - a*b*lam^6 + 4*a*b*lam^4 - 3*a*b*lam^2 - a*lam^4 + 3*a*lam^2 - b^2*lam^5 + 3*b^2*lam^3 - b^2*lam + b*lam^5 - 3*b*lam^3 + 2*b*lam - lam := by rw [hf_eq]; ring
    linarith [hr, he]

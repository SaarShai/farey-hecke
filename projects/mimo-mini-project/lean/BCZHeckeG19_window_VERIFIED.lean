  have hP2c : c*d*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP2
  have hP3c : d*e*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP3
  have hP4c : e*f*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP4

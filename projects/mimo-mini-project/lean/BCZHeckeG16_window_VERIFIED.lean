import Mathlib
set_option maxHeartbeats 20000000
noncomputable section
open Int

/-- Interior-floor contradiction (K>=2 impossible inside a sub-threshold window): if a
middle coord `m` has `lam^4 m^2 < 1` (= the K>=2 bound) and a neighbour `n` with `lam^4 n^2
< 2` and edge `1 - lam m < n`, then False.  Uses only `9/5 < lam < 2` via `(lam^2-lam)^2
>= 2` — field-independent. -/
lemma g16_floor_helper (lam m n : ℝ) (h2 : (1:ℝ) < lam) (h3 : lam < 2)
    (hlo : (9:ℝ)/5 < lam) (hm : 0 < m) (hn : 0 < n)
    (hms : lam^4 * m^2 < 1) (hns : lam^4 * n^2 < 2) (hedge : 1 - lam*m < n) : False := by
  have hpos : (0:ℝ) < lam := by linarith
  have hl2 : (1:ℝ) < lam^2 := by nlinarith [h2]
  have hlm : lam^2 * m < 1 := by nlinarith [hms, mul_pos (mul_pos hpos hpos) hm, sq_nonneg (lam^2*m)]
  have hlm1 : lam*m < 1 := by nlinarith [hlm, hl2, hm, mul_pos hpos hm]
  have h1lm : (0:ℝ) < 1 - lam*m := by linarith
  have hnsq : (1 - lam*m)^2 < n^2 := by nlinarith [hedge, h1lm, hn]
  have hml : (36:ℝ)/25 ≤ lam^2 - lam := by nlinarith [mul_pos (show (0:ℝ)<lam-9/5 by linarith) (show (0:ℝ)<lam+4/5 by linarith)]
  have hKey : (2:ℝ) ≤ lam^4 - 2*lam^3 + lam^2 := by nlinarith [hml, sq_nonneg (lam^2-lam), mul_pos hpos (show (0:ℝ)<lam-1 by linarith)]
  have hA : lam^4 * (1 - lam*m)^2 < 2 := by nlinarith [hnsq, hns, mul_pos (mul_pos (mul_pos hpos hpos) hpos) hpos]
  nlinarith [hA, hKey, h1lm, hlm, hpos, hl2, mul_pos hpos h1lm, sq_nonneg (lam - lam^2*m), sq_nonneg (lam*(1-lam*m))]

lemma case_q16 (a b c d e f lam : ℝ) (hps : lam^8 = 8*lam^6 - 20*lam^4 + 16*lam^2 - 2) (h2 : (1:ℝ) < lam) (h3 : lam < 2)
    (hpa : 0 < a) (hpb : 0 < b) (hpc : 0 < c) (hpd : 0 < d) (hpe : 0 < e) (hpf : 0 < f)
    (hca : a ≤ 1) (hcb : b ≤ 1) (hcc : c ≤ 1) (hcd : d ≤ 1) (hce : e ≤ 1) (hcf : f ≤ 1)
    (hr0 : a+lam*b > 1) (hr1 : b+lam*c > 1) (hr2 : c+lam*d > 1) (hr3 : d+lam*e > 1) (hr4 : e+lam*f > 1)
    (hg0 : lam*a+b > 1) (hg1 : lam*b+c > 1) (hg2 : lam*c+d > 1) (hg3 : lam*d+e > 1) (hg4 : lam*e+f > 1)
    (hk0 : a+c = 1*lam*b) (hk1 : b+d = 1*lam*c) (hk2 : c+e = 1*lam*d) (hk3 : d+f = 1*lam*e)
    (hf0 : 1+a < (1+1)*(lam*b)) (hf1 : 1+b < (1+1)*(lam*c)) (hf2 : 1+c < (1+1)*(lam*d)) (hf3 : 1+d < (1+1)*(lam*e))
    (hP0 : a*b < 1/lam^3) (hP1 : b*c < 1/lam^3) (hP2 : c*d < 1/lam^3) (hP3 : d*e < 1/lam^3) (hP4 : e*f < 1/lam^3) :
    False := by
  have hpos : (0:ℝ) < lam := by linarith
  have hp3 : (0:ℝ) < lam^3 := by positivity
  have pos0 : (0:ℝ) ≤ a := le_of_lt hpa
  have pos1 : (0:ℝ) ≤ b := le_of_lt hpb
  have pos2 : (0:ℝ) ≤ c := le_of_lt hpc
  have pos3 : (0:ℝ) ≤ d := le_of_lt hpd
  have pos4 : (0:ℝ) ≤ e := le_of_lt hpe
  have pos5 : (0:ℝ) ≤ f := le_of_lt hpf
  have cap0 : (0:ℝ) ≤ 1 - a := by nlinarith [hca]
  have cap1 : (0:ℝ) ≤ 1 - b := by nlinarith [hcb]
  have cap2 : (0:ℝ) ≤ 1 - c := by nlinarith [hcc]
  have cap3 : (0:ℝ) ≤ 1 - d := by nlinarith [hcd]
  have cap4 : (0:ℝ) ≤ 1 - e := by nlinarith [hce]
  have cap5 : (0:ℝ) ≤ 1 - f := by nlinarith [hcf]
  have reg0 : (0:ℝ) ≤ a + b*lam - 1 := by nlinarith [hr0]
  have reg1 : (0:ℝ) ≤ b + c*lam - 1 := by nlinarith [hr1]
  have reg2 : (0:ℝ) ≤ c + d*lam - 1 := by nlinarith [hr2]
  have reg3 : (0:ℝ) ≤ d + e*lam - 1 := by nlinarith [hr3]
  have reg4 : (0:ℝ) ≤ e + f*lam - 1 := by nlinarith [hr4]
  have gen0 : (0:ℝ) ≤ a*lam + b - 1 := by nlinarith [hg0]
  have gen1 : (0:ℝ) ≤ b*lam + c - 1 := by nlinarith [hg1]
  have gen2 : (0:ℝ) ≤ c*lam + d - 1 := by nlinarith [hg2]
  have gen3 : (0:ℝ) ≤ d*lam + e - 1 := by nlinarith [hg3]
  have gen4 : (0:ℝ) ≤ e*lam + f - 1 := by nlinarith [hg4]
  have slk0 : (0:ℝ) ≤ -a*b*lam^3 + 1 := by
    have hh : (a*b)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP0
    nlinarith [hh]
  have slk1 : (0:ℝ) ≤ -b*c*lam^3 + 1 := by
    have hh : (b*c)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP1
    nlinarith [hh]
  have slk2 : (0:ℝ) ≤ -c*d*lam^3 + 1 := by
    have hh : (c*d)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP2
    nlinarith [hh]
  have slk3 : (0:ℝ) ≤ -d*e*lam^3 + 1 := by
    have hh : (d*e)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP3
    nlinarith [hh]
  have slk4 : (0:ℝ) ≤ -e*f*lam^3 + 1 := by
    have hh : (e*f)*lam^3 < 1 := (lt_div_iff₀ hp3).mp hP4
    nlinarith [hh]
  have flu0 : (0:ℝ) ≤ -a + 2*b*lam - 1 := by nlinarith [hf0]
  have flu1 : (0:ℝ) ≤ -b + 2*c*lam - 1 := by nlinarith [hf1]
  have flu2 : (0:ℝ) ≤ -c + 2*d*lam - 1 := by nlinarith [hf2]
  have flu3 : (0:ℝ) ≤ -d + 2*e*lam - 1 := by nlinarith [hf3]
  have qq0 : (0:ℝ) ≤ -a^2*lam^5 + a^2*lam^3 + a^2*lam + a*b*lam^6 - 2*a*b*lam^4 - a*b*lam^2 - a*lam := by
    have hr : (0:ℝ) ≤ lam*((a)*(e + f*lam - 1)) := mul_nonneg hpos.le (mul_nonneg pos0 reg4)
    have he : lam*((a)*(e + f*lam - 1)) = -a^2*lam^5 + a^2*lam^3 + a^2*lam + a*b*lam^6 - 2*a*b*lam^4 - a*b*lam^2 - a*lam := by linear_combination (a*lam^5 - a*lam^3 - a*lam)*hk0 + (a*lam^4)*hk1 + (a*lam^3 + a*lam)*hk2 + (a*lam^2)*hk3
    linarith [hr, he]
  have qq1 : (0:ℝ) ≤ a^2*lam^2 + a*b*lam - a*lam := by
    have hr : (0:ℝ) ≤ lam*((a)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg pos0 gen0)
    have he : lam*((a)*(a*lam + b - 1)) = a^2*lam^2 + a*b*lam - a*lam := by linear_combination 0
    linarith [hr, he]
  have qq2 : (0:ℝ) ≤ -a^3*lam^5 + 2*a^2*b*lam^6 - a^2*b*lam^4 - a*b^2*lam^7 + a*b^2*lam^5 + a*lam := by
    have hr : (0:ℝ) ≤ lam*((a)*(-c*d*lam^3 + 1)) := mul_nonneg hpos.le (mul_nonneg pos0 slk2)
    have he : lam*((a)*(-c*d*lam^3 + 1)) = -a^3*lam^5 + 2*a^2*b*lam^6 - a^2*b*lam^4 - a*b^2*lam^7 + a*b^2*lam^5 + a*lam := by linear_combination (a^2*lam^5 - a*b*lam^6 - a*d*lam^4)*hk0 + (a^2*lam^4 - a*b*lam^5)*hk1
    linarith [hr, he]
  have qq3 : (0:ℝ) ≤ -a^2*lam^5 + 2*a^2*lam^3 + a*b*lam^6 - 4*a*b*lam^4 + 3*a*b*lam^2 + a*lam^4 - 2*a*lam^2 + b^2*lam^5 - 3*b^2*lam^3 + b^2*lam - b*lam^5 + 3*b*lam^3 - b*lam := by
    have hr : (0:ℝ) ≤ lam*((f)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg pos5 gen0)
    have he : lam*((f)*(a*lam + b - 1)) = -a^2*lam^5 + 2*a^2*lam^3 + a*b*lam^6 - 4*a*b*lam^4 + 3*a*b*lam^2 + a*lam^4 - 2*a*lam^2 + b^2*lam^5 - 3*b^2*lam^3 + b^2*lam - b*lam^5 + 3*b*lam^3 - b*lam := by linear_combination (a*lam^5 - 2*a*lam^3 + b*lam^4 - 2*b*lam^2 - lam^4 + 2*lam^2)*hk0 + (a*lam^4 - a*lam^2 + b*lam^3 - b*lam - lam^3 + lam)*hk1 + (a*lam^3 + b*lam^2 - lam^2)*hk2 + (a*lam^2 + b*lam - lam)*hk3
    linarith [hr, he]
  have qq4 : (0:ℝ) ≤ 6*a^3*lam^6 - 20*a^3*lam^4 + 16*a^3*lam^2 - 2*a^3 - 16*a^2*b*lam^7 + 57*a^2*b*lam^5 - 48*a^2*b*lam^3 + 6*a^2*b*lam + 59*a*b^2*lam^6 - 233*a*b^2*lam^4 + 218*a*b^2*lam^2 - 28*a*b^2 - a*lam^4 + 2*a*lam^2 - 16*b^3*lam^7 + 65*b^3*lam^5 - 62*b^3*lam^3 + 8*b^3*lam + b*lam^5 - 3*b*lam^3 + b*lam := by
    have hr : (0:ℝ) ≤ lam*((f)*(-c*d*lam^3 + 1)) := mul_nonneg hpos.le (mul_nonneg pos5 slk2)
    have he : lam*((f)*(-c*d*lam^3 + 1)) = 6*a^3*lam^6 - 20*a^3*lam^4 + 16*a^3*lam^2 - 2*a^3 - 16*a^2*b*lam^7 + 57*a^2*b*lam^5 - 48*a^2*b*lam^3 + 6*a^2*b*lam + 59*a*b^2*lam^6 - 233*a*b^2*lam^4 + 218*a*b^2*lam^2 - 28*a*b^2 - a*lam^4 + 2*a*lam^2 - 16*b^3*lam^7 + 65*b^3*lam^5 - 62*b^3*lam^3 + 8*b^3*lam + b*lam^5 - 3*b*lam^3 + b*lam := by linear_combination (-a^2*lam^8 + 2*a^2*lam^6 + 2*a*b*lam^9 - 5*a*b*lam^7 + 2*a*b*lam^5 + a*f*lam^5 - b^2*lam^10 + 3*b^2*lam^8 - 2*b^2*lam^6 - b*f*lam^6 - d*f*lam^4 + lam^4 - 2*lam^2)*hk0 + (-a^2*lam^7 + a^2*lam^5 + 2*a*b*lam^8 - 3*a*b*lam^6 + a*b*lam^4 + a*f*lam^4 - b^2*lam^9 + 2*b^2*lam^7 - b^2*lam^5 - b*f*lam^5 + lam^3 - lam)*hk1 + (-a^2*lam^6 + 2*a*b*lam^7 - a*b*lam^5 - b^2*lam^8 + b^2*lam^6 + lam^2)*hk2 + (-a^2*lam^5 + 2*a*b*lam^6 - a*b*lam^4 - b^2*lam^7 + b^2*lam^5 + lam)*hk3 + (a^3 - 3*a^2*b*lam + 3*a*b^2*lam^2 + 14*a*b^2 - b^3*lam^3 - 4*b^3*lam)*hps
    linarith [hr, he]
  have qq5 : (0:ℝ) ≤ -a^2*lam^5 + a^2*lam^3 + a^2*lam + 2*a*b*lam^6 - 3*a*b*lam^4 - 2*a*b*lam^2 - a*lam^5 + a*lam^3 - b^2*lam^7 + 2*b^2*lam^5 + b^2*lam^3 + b*lam^6 - 2*b*lam^4 - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - c)*(e + f*lam - 1)) := mul_nonneg hpos.le (mul_nonneg cap2 reg4)
    have he : lam*((1 - c)*(e + f*lam - 1)) = -a^2*lam^5 + a^2*lam^3 + a^2*lam + 2*a*b*lam^6 - 3*a*b*lam^4 - 2*a*b*lam^2 - a*lam^5 + a*lam^3 - b^2*lam^7 + 2*b^2*lam^5 + b^2*lam^3 + b*lam^6 - 2*b*lam^4 - lam := by linear_combination (a*lam^5 - a*lam^3 - a*lam - b*lam^6 + b*lam^4 + b*lam^2 - e*lam - f*lam^2 + lam^5 - lam^3)*hk0 + (a*lam^4 - b*lam^5 + lam^4)*hk1 + (a*lam^3 + a*lam - b*lam^4 - b*lam^2 + lam^3 + lam)*hk2 + (a*lam^2 - b*lam^3 + lam^2)*hk3
    linarith [hr, he]
  have qq6 : (0:ℝ) ≤ a^2*lam^3 - a*b*lam^4 + 2*a*b*lam^2 - b^2*lam^3 + b^2*lam + b*lam^3 - lam := by
    have hr : (0:ℝ) ≤ lam*((1 - d)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg cap3 gen0)
    have he : lam*((1 - d)*(a*lam + b - 1)) = a^2*lam^3 - a*b*lam^4 + 2*a*b*lam^2 - b^2*lam^3 + b^2*lam + b*lam^3 - lam := by linear_combination (-a*lam^3 - b*lam^2 + lam^2)*hk0 + (-a*lam^2 - b*lam + lam)*hk1
    linarith [hr, he]
  have qq7 : (0:ℝ) ≤ a^2*lam^2 + a*b*lam^3 + a*b*lam - a*lam^2 - a*lam + b^2*lam^2 - b*lam^2 - b*lam + lam := by
    have hr : (0:ℝ) ≤ lam*((a + b*lam - 1)*(a*lam + b - 1)) := mul_nonneg hpos.le (mul_nonneg reg0 gen0)
    have he : lam*((a + b*lam - 1)*(a*lam + b - 1)) = a^2*lam^2 + a*b*lam^3 + a*b*lam - a*lam^2 - a*lam + b^2*lam^2 - b*lam^2 - b*lam + lam := by linear_combination 0
    linarith [hr, he]
  have qq8 : (0:ℝ) ≤ -2*a^2*lam^4 + 3*a^2*lam^2 - 2*a*b*lam^3 + a*b*lam + 2*a*lam^4 - 3*a*lam^2 - a*lam + 2*b^2*lam^6 - 5*b^2*lam^4 + b^2*lam^2 - 2*b*lam^5 + 5*b*lam^3 - b*lam^2 - b*lam + lam := by
    have hr : (0:ℝ) ≤ lam*((a + b*lam - 1)*(e*lam + f - 1)) := mul_nonneg hpos.le (mul_nonneg reg0 gen4)
    have he : lam*((a + b*lam - 1)*(e*lam + f - 1)) = -2*a^2*lam^4 + 3*a^2*lam^2 - 2*a*b*lam^3 + a*b*lam + 2*a*lam^4 - 3*a*lam^2 - a*lam + 2*b^2*lam^6 - 5*b^2*lam^4 + b^2*lam^2 - 2*b*lam^5 + 5*b*lam^3 - b*lam^2 - b*lam + lam := by linear_combination (2*a*lam^4 - 3*a*lam^2 + 2*b*lam^5 - 3*b*lam^3 - 2*lam^4 + 3*lam^2)*hk0 + (2*a*lam^3 - a*lam + 2*b*lam^4 - b*lam^2 - 2*lam^3 + lam)*hk1 + (2*a*lam^2 + 2*b*lam^3 - 2*lam^2)*hk2 + (a*lam + b*lam^2 - lam)*hk3
    linarith [hr, he]
  have qq9 : (0:ℝ) ≤ -a^3*lam^5 + a^2*b*lam^6 - a^2*b*lam^4 + a^2*lam^5 + a*b^2*lam^7 - 2*a*b*lam^6 + a*b*lam^4 + a*lam - 7*b^3*lam^6 + 20*b^3*lam^4 - 16*b^3*lam^2 + 2*b^3 + b^2*lam^7 - b^2*lam^5 + b*lam^2 - lam := by
    have hr : (0:ℝ) ≤ lam*((a + b*lam - 1)*(-c*d*lam^3 + 1)) := mul_nonneg hpos.le (mul_nonneg reg0 slk2)
    have he : lam*((a + b*lam - 1)*(-c*d*lam^3 + 1)) = -a^3*lam^5 + a^2*b*lam^6 - a^2*b*lam^4 + a^2*lam^5 + a*b^2*lam^7 - 2*a*b*lam^6 + a*b*lam^4 + a*lam - 7*b^3*lam^6 + 20*b^3*lam^4 - 16*b^3*lam^2 + 2*b^3 + b^2*lam^7 - b^2*lam^5 + b*lam^2 - lam := by linear_combination (a^2*lam^5 - a*d*lam^4 - a*lam^5 - b^2*lam^7 - b*d*lam^5 + b*lam^6 + d*lam^4)*hk0 + (a^2*lam^4 - a*lam^4 - b^2*lam^6 + b*lam^5)*hk1 + (-b^3)*hps
    linarith [hr, he]
  have qq10 : (0:ℝ) ≤ 6*a^2*lam^7 - 21*a^2*lam^5 + 18*a^2*lam^3 - a^2*lam - 40*a*b*lam^6 + 162*a*b*lam^4 - 158*a*b*lam^2 + 20*a*b + 2*a*lam^5 - 2*a*lam^3 - 2*a*lam + 14*b^2*lam^7 - 60*b^2*lam^5 + 63*b^2*lam^3 - 8*b^2*lam - 2*b*lam^6 + 4*b*lam^4 + 2*b*lam^2 + lam := by
    have hr : (0:ℝ) ≤ lam*((e + f*lam - 1)*(e + f*lam - 1)) := mul_nonneg hpos.le (mul_nonneg reg4 reg4)
    have he : lam*((e + f*lam - 1)*(e + f*lam - 1)) = 6*a^2*lam^7 - 21*a^2*lam^5 + 18*a^2*lam^3 - a^2*lam - 40*a*b*lam^6 + 162*a*b*lam^4 - 158*a*b*lam^2 + 20*a*b + 2*a*lam^5 - 2*a*lam^3 - 2*a*lam + 14*b^2*lam^7 - 60*b^2*lam^5 + 63*b^2*lam^3 - 8*b^2*lam - 2*b*lam^6 + 4*b*lam^4 + 2*b*lam^2 + lam := by linear_combination (-a*lam^9 + 2*a*lam^7 + a*lam^5 - 2*a*lam^3 - a*lam + b*lam^10 - 3*b*lam^8 + 3*b*lam^4 + 2*b*lam^2 + e*lam^3 - e*lam + f*lam^6 - 2*f*lam^2 - 2*lam^5 + 2*lam^3 + 2*lam)*hk0 + (-a*lam^8 + a*lam^6 + a*lam^4 - a*lam^2 + b*lam^9 - 2*b*lam^7 - b*lam^5 + b*lam^3 + e*lam^2 + f*lam^5 + f*lam^3 - 2*lam^4)*hk1 + (-a*lam^7 + a*lam^3 + a*lam + b*lam^8 - b*lam^6 - 2*b*lam^4 - 2*b*lam^2 + e*lam + f*lam^4 + 2*f*lam^2 - 2*lam^3 - 2*lam)*hk2 + (-a*lam^6 + 2*a*lam^2 + b*lam^7 - b*lam^5 - 3*b*lam^3 + f*lam^3 - 2*lam^2)*hk3 + (a^2*lam - 2*a*b*lam^2 - 10*a*b + b^2*lam^3 + 4*b^2*lam)*hps
    linarith [hr, he]
  have qq11 : (0:ℝ) ≤ 11*a^2*lam^6 - 39*a^2*lam^4 + 35*a^2*lam^2 - 4*a^2 - 18*a*b*lam^7 + 72*a*b*lam^5 - 71*a*b*lam^3 + 9*a*b*lam + a*lam^5 + 2*a*lam^4 - a*lam^3 - 3*a*lam^2 - a*lam + 25*b^2*lam^6 - 105*b^2*lam^4 + 107*b^2*lam^2 - 14*b^2 - b*lam^6 - 2*b*lam^5 + 2*b*lam^4 + 5*b*lam^3 + b*lam^2 - b*lam + lam := by
    have hr : (0:ℝ) ≤ lam*((e + f*lam - 1)*(e*lam + f - 1)) := mul_nonneg hpos.le (mul_nonneg reg4 gen4)
    have he : lam*((e + f*lam - 1)*(e*lam + f - 1)) = 11*a^2*lam^6 - 39*a^2*lam^4 + 35*a^2*lam^2 - 4*a^2 - 18*a*b*lam^7 + 72*a*b*lam^5 - 71*a*b*lam^3 + 9*a*b*lam + a*lam^5 + 2*a*lam^4 - a*lam^3 - 3*a*lam^2 - a*lam + 25*b^2*lam^6 - 105*b^2*lam^4 + 107*b^2*lam^2 - 14*b^2 - b*lam^6 - 2*b*lam^5 + 2*b*lam^4 + 5*b*lam^3 + b*lam^2 - b*lam + lam := by linear_combination (-2*a*lam^8 + 5*a*lam^6 - a*lam^4 - 3*a*lam^2 + 2*b*lam^9 - 7*b*lam^7 + 4*b*lam^5 + 4*b*lam^3 + e*lam^4 - e*lam^2 + 2*f*lam^5 - 2*f*lam^3 - f*lam - lam^5 - 2*lam^4 + lam^3 + 3*lam^2 + lam)*hk0 + (-2*a*lam^7 + 3*a*lam^5 - a*lam + 2*b*lam^8 - 5*b*lam^6 + b*lam^4 + b*lam^2 + e*lam^3 + 2*f*lam^4 - lam^4 - 2*lam^3 + lam)*hk1 + (-2*a*lam^6 + a*lam^4 + 2*a*lam^2 + 2*b*lam^7 - 3*b*lam^5 - 3*b*lam^3 + e*lam^2 + 2*f*lam^3 + f*lam - lam^3 - 2*lam^2 - lam)*hk2 + (-2*a*lam^5 + 2*a*lam^3 + a*lam + 2*b*lam^6 - 4*b*lam^4 - b*lam^2 + f*lam^2 - lam^2 - lam)*hk3 + (2*a^2 - 4*a*b*lam + 2*b^2*lam^2 + 7*b^2)*hps
    linarith [hr, he]
